# ==========================================================================
# NOVIKA — plantilla de variables de entorno
#
# Este archivo SOLO documenta los NOMBRES de las variables y para que sirve
# cada una. Nunca escribas aqui un valor real: este repositorio es publico.
#
# Los valores reales se configuran en el panel del hosting (Render ->
# Environment) o en un archivo .env local que .gitignore ya excluye.
#
# Aislamiento: ninguna de estas variables debe compartir valor con BIKERPRO
# (repositorio mtavera99/impermeables). El arranque se bloquea si detecta un
# identificador conocido de BIKERPRO. Ver src/aislamiento.js.
# ==========================================================================


# --------------------------------------------------------------------------
# 1. OBLIGATORIAS PARA QUE META VERIFIQUE EL WEBHOOK
# --------------------------------------------------------------------------

# Cadena secreta que TU inventas. Debe ser identica en dos sitios:
#   a) esta variable en el hosting
#   b) el campo "Token de verificacion" en Meta -> Webhooks
# Meta solo la usa durante el handshake GET. Minimo 16 caracteres.
# Generala con:  openssl rand -hex 32
#   o con:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=

# Clave secreta de la app de Meta ("Bot Novika" -> Configuracion de la app ->
# Basica -> Clave secreta de la app). Con ella se valida la firma
# X-Hub-Signature-256 de cada POST entrante.
# Sin esta variable el servidor ARRANCA y Meta puede verificar el webhook,
# pero los eventos entrantes se registran y se DESCARTAN sin procesar,
# porque no se puede demostrar que vengan de Meta.
META_APP_SECRET=


# --------------------------------------------------------------------------
# 2. NECESARIAS PARA ENVIAR Y PARA FILTRAR POR NUMERO (fase 2)
# --------------------------------------------------------------------------

# Token de acceso de la WABA de NOVIKA (Graph API). Es el que caduca.
WHATSAPP_TOKEN=

# ID del numero de telefono de NOVIKA en Meta. OJO: NO es el numero de
# telefono, es un ID numerico largo que Meta genera.
# Si esta definido, actua como candado de aislamiento: todo evento cuyo
# metadata.phone_number_id sea distinto se descarta sin procesar.
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA) de NOVIKA.
WHATSAPP_WABA_ID=

# Version de la Graph API. Un solo sitio, no repetida por el codigo.
GRAPH_VERSION=v21.0


# --------------------------------------------------------------------------
# 3. OPERACION
# --------------------------------------------------------------------------

# Puerto HTTP. En Render lo inyecta la plataforma; no hace falta tocarlo.
PORT=3000

# Carpeta con estado persistente (diario de eventos, ids ya vistos).
#
# EL SISTEMA DE ARCHIVOS DE UN WEB SERVICE DE RENDER ES EFIMERO. Esta
# variable debe apuntar al Mount Path de un Disk propio de NOVIKA
# (render.yaml lo declara en /var/data).
#
# Definir esta variable NO crea el disco. Si el Disk no esta montado,
# /var/data es una carpeta corriente que desaparece en el siguiente
# despliegue. El servidor lo COMPRUEBA al arrancar comparando sistemas de
# archivos, y lo publica en /health como "persistencia".
DATA_DIR=

# Escape explicito: permite encender RESPUESTA_AUTOMATICA aunque el
# almacenamiento sea efimero. Por defecto esa combinacion BLOQUEA el
# arranque, porque sin memoria que sobreviva al despliegue un reintento de
# Meta se procesa dos veces (y Meta reintenta hasta 36 horas). Usalo solo
# para una prueba controlada.
PERMITIR_SIN_PERSISTENCIA=0

# Token para las rutas de lectura/diagnostico (/eventos, detalle de /health).
# Secreto DISTINTO al de verificacion: este da acceso a datos de clientes.
PANEL_TOKEN=

# Nivel de log: error | warn | info | debug
LOG_NIVEL=info

# Por defecto los logs enmascaran telefonos y no imprimen el texto de los
# mensajes. Pon 1 solo para depurar, y vuelve a 0 despues.
LOG_PII=0

# Interruptor maestro de respuestas salientes. En 0, NOVIKA recibe, registra
# y procesa, pero NO escribe a ningun cliente. Mantener en 0 hasta que el
# guion comercial este definido y aprobado.
RESPUESTA_AUTOMATICA=0

# ---------------------------------------------------------------------------
# RECORDATORIOS: el bot le escribe PRIMERO al cliente que se quedo callado.
#
# ⚠️ APAGADO POR DEFECTO, Y NO ES PRUDENCIA DE ADORNO. Es la unica funcion
#    que manda mensajes que NADIE pidio a numeros de clientes reales. Con
#    una campaña encendida, equivocarse aqui es spam desde el numero de la
#    empresa — y un reporte de spam cuesta la calidad del numero, que vale
#    mas que cualquier venta suelta.
#
# Minutos de silencio de cada toque, separados por coma. Los eligio Marco:
# uno a los 30 minutos y otro a las 3 horas. LOS DOS CABEN DENTRO DE LA
# VENTANA DE 24 H DE WHATSAPP, asi que no necesitan plantilla aprobada.
#
# Los toques clasicos de 24 h y 72 h SI la necesitan: Meta solo entrega
# plantillas aprobadas pasada esa ventana. Cuando la plantilla exista, se
# añade aqui el toque largo.
# ---------------------------------------------------------------------------
RECORDATORIOS=0
RECORDATORIO_MINUTOS=30,180

# Franja horaria en que se permiten, en hora de BOGOTA (no la del servidor,
# que en Render va en UTC). Un recordatorio a las 3 de la mañana no vende:
# hace que te bloqueen.
RECORDATORIOS_DESDE_HORA=8
RECORDATORIOS_HASTA_HORA=21

# Interruptor PROPIO del panel para los envios manuales de un operador.
#
# Aparte de RESPUESTA_AUTOMATICA a proposito: ese interruptor existe para que
# el BOT no hable, y una persona que pulsa enviar en el panel no es el bot.
# Pero tampoco puede quedar implicito, porque entonces el panel seria una
# puerta abierta a enviar WhatsApps reales sin haberlo decidido.
#
# Con 0 el panel se opera COMPLETO: el mensaje queda en la conversacion con
# su motivo real ("no enviado: envio_manual_apagado") y no sale nada.
PANEL_ENVIO_MANUAL=0

# Lista blanca para PROBAR EN PRODUCCION sin abrir al publico.
#
# Vacia = sin restriccion: el bot atiende a quien escriba. Con numeros =
# SOLO esos reciben respuesta del bot; al resto se le registra el mensaje y
# queda en el panel como pendiente para contestarle a mano, pero el bot se
# calla.
#
# POR QUE EXISTE: `filtro_de_numero` suena a esto y no lo es -compara el
# phone_number_id NUESTRO, para que no entren eventos de otra app de Meta-.
# Sin esta lista, encender RESPUESTA_AUTOMATICA para probar le contesta a
# CUALQUIERA que escriba. Probar y abrir al publico eran la misma palanca.
#
# Varios separados por coma. El prefijo del pais no importa: 573001112233 y
# 3001112233 se tratan como el mismo numero.
#
# ABRIR AL PUBLICO ES BORRAR ESTA LISTA, y es una decision aparte.
NUMEROS_DE_PRUEBA=

# Zona horaria del negocio: los cortes de dia se calculan con ella.
ZONA_HORARIA=America/Bogota


# --------------------------------------------------------------------------
# 4. FASE 2 · CEREBRO
# --------------------------------------------------------------------------

# Modo sombra. Con 1, el mensaje real se procesa de principio a fin y la
# respuesta se PREPARA y se registra, pero NO se envia. Es como se audita el
# bot con trafico real antes de dejarlo hablar. Por defecto: 1.
MODO_SOMBRA=1

# Clave del proveedor de IA (compatible con /v1/chat/completions).
# SIN ESTA CLAVE EL SISTEMA SIGUE FUNCIONANDO: la extraccion heuristica y el
# cotizador son deterministas. Lo que se pierde es la redaccion natural y la
# clasificacion de intencion, no la capacidad de atender.
IA_API_KEY=

# Proveedor y modelo. Van por variable para poder cambiar de proveedor sin
# tocar codigo: los precios de los modelos se mueven mucho.
IA_BASE_URL=https://api.openai.com/v1
IA_MODELO=gpt-4o-mini
IA_TIMEOUT_MS=12000

# PostgreSQL para la informacion transaccional (pedidos, conversaciones,
# estados). Mientras este VACIA se usan archivos sobre el disco persistente.
#
# El adaptador YA EXISTE y pasa las mismas pruebas de contrato que el de
# archivos. Antes de configurarla hay que, en este orden:
#   1. crear la base en Render (de pago, nunca la gratuita)
#   2. aplicar el esquema:  npm run migrar
#   3. congelar escrituras: npm run congelar
#   4. copiar los datos:    npm run cutover
#   5. configurar esta variable y reiniciar
#   6. descongelar:         npm run descongelar
#   7. reiniciar otra vez (vacia los mensajes diferidos)
#
# El paso 5 va ANTES del 6: si se descongelara primero, el servicio
# procesaria los mensajes diferidos contra archivos y crearia datos que la
# base no tiene.
#
# Si se configura sin aplicar el esquema, EL ARRANQUE FALLA y lo dice: el
# servicio no crea tablas por su cuenta a proposito. Ver docs/POSTGRES.md.
#
# Usa la Internal Database URL de Render: no sale a internet.
#
# LA BITACORA DE TRABAJO DEL WEBHOOK NO SE MUEVE AQUI. Se queda en el disco
# a proposito: es lo unico que tiene que funcionar cuando la base no
# responda, porque de ella depende contestar 200 a Meta sin perder el mensaje.
DATABASE_URL=

# Solo para las PRUEBAS: base contra la que verificar el adaptador. El
# servicio no la usa. Sin ella, las pruebas de PostgreSQL se saltan.
DATABASE_URL_PRUEBAS=


# --------------------------------------------------------------------------
# 5. AVISOS AL DUENO (opcional)
# --------------------------------------------------------------------------

# Numero de WhatsApp del dueno de NOVIKA, en formato internacional sin "+".
# Se usa para avisar de fallos que, en silencio, costarian ventas.
OWNER_WHATSAPP=


# --------------------------------------------------------------------------
# 6. DESPACHO: GUIAS Y NOVEDADES DE ENTREGA
# --------------------------------------------------------------------------
#
# Esta seccion gobierna los dos mensajes mas valiosos del negocio: la guia
# de envio y el aviso de una novedad de entrega.
#
# LOS DOS CAEN FUERA DE LA VENTANA DE 24 HORAS DE META, y eso no es el caso
# raro, es el caso normal:
#
#   · la guia se despacha al dia siguiente de la compra
#   · una novedad la reporta la transportadora 1 a 3 dias despues
#
# Fuera de esa ventana Meta SOLO entrega plantillas aprobadas. Con texto
# libre acepta el mensaje -responde ok, con su wamid- y NO LO ENTREGA. Se
# midio en BIKERPRO con el cierre diario. Por eso, sin plantilla, el panel
# marca la fila como BLOQUEADA en vez de intentarlo: un envio que falla en
# silencio es peor que no enviar, porque el operador tacha al cliente de su
# lista creyendo que ya esta avisado.

# El codigo de idioma EXACTO con el que se subieron las plantillas a Meta.
#
# "es_CO", NO "es". Para Meta son dos TRADUCCIONES distintas de la misma
# plantilla: con "es" rechaza con el error 132001 -"template name does not
# exist in the translation"- aunque la plantilla este aprobada y visible en
# el panel de Meta. El mensaje de error habla del NOMBRE, asi que se busca
# el fallo en el nombre y no en el idioma, que es donde esta.
PLANTILLA_IDIOMA=es_CO

# --- Novedades de entrega: UNA PLANTILLA POR TIPO ---
#
# Una sola plantilla generica ("tu pedido tuvo una novedad, responde")
# obliga al cliente a PREGUNTAR que paso, y ahi se pierde gente justo
# cuando el paquete esta a dias de devolverse. Con una por caso, al cliente
# le llega lo que necesita saber sin preguntar nada.
#
# Hay que crearlas en Meta Business Manager y esperar su aprobacion. Vacias
# = ese tipo de novedad queda bloqueado, y el panel lo dice ARRIBA, antes de
# que se suba ningun archivo.
#
# La de oficina necesita DOS variables, en este orden:
#   {{1}} la oficina donde reclamar
#   {{2}} hasta cuando
# Si faltan, la fila queda bloqueada pidiendolos. NUNCA se inventa una
# oficina: el 14-sep BIKERPRO prometio "la oficina de Servientrega en
# Potosi" y Servientrega no presta recogida en oficina. La clienta lo leyo.
PLANTILLA_NOVEDAD_DIRECCION=
PLANTILLA_NOVEDAD_AUSENTE=
PLANTILLA_NOVEDAD_OFICINA=

# --- Guia de envio ---
#
# Plantilla con el PDF de la guia en la CABECERA (tipo documento). Es el
# camino normal, no la excepcion: la guia sale al dia siguiente de la
# compra, asi que la ventana del cliente casi siempre esta cerrada.
#
# Si el cliente escribio en las ultimas 24 h, el PDF se manda como documento
# con pie de foto y esta plantilla no se usa. El panel dice cual de los dos
# caminos se uso en cada guia.
PLANTILLA_GUIA=

# --- Los telefonos propios que van IMPRESOS en la etiqueta ---
#
# Sirve para no confundir el telefono del remitente con el del cliente al
# parear una guia. Un telefono vale 50 puntos -la senal mas fuerte del
# puntaje-, asi que colar el numero propio como si fuera del destinatario
# ensucia el pareo entero.
#
# ES UNA VARIABLE APARTE DE OWNER_WHATSAPP, y la separacion viene de un
# incidente: en BIKERPRO el dueno movio los avisos del bot a su celular
# personal, y como se usaba la misma variable para las dos cosas, el
# telefono impreso en la etiqueta dejo de reconocerse.
#
# Son dos preguntas distintas: "a quien le aviso" y "que numero va impreso
# en la etiqueta". Acepta varios separados por coma: excluir un numero
# propio de mas no cuesta nada, olvidarse de uno si.
TELEFONOS_REMITENTE=
